# Copy to .env and adjust values.

# SQLite database location (inside container, mounted as a volume)
DATABASE_URL=sqlite+aiosqlite:///./data/mealtrack.db

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Default user seeded on first startup
DEFAULT_USER_NAME=Wajahat Ahmed
DEFAULT_USER_EMAIL=wajahatahmad056@gmail.com
DEFAULT_USER_PASSWORD=change-me

# Gemini AI evaluation
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
SCHEDULER_TIMEZONE=Asia/Karachi

# Redis Streams — used by the exercise event consumer.
# In production Docker: the Gym Tracker Redis container is on the shared
# tracker-bus network with alias "redis". Set this in production .env:
REDIS_URL=redis://redis:6379/0
